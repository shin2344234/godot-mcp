{
  "name": "@shin2344234/godot-mcp",
  "version": "0.1.1",
  "description": "MCP server for the Godot 4 engine: edit scenes, nodes and scripts, run the game and read errors, through a live editor bridge or headless Godot.",
  "mcpName": "io.github.shin2344234/godot-mcp",
  "type": "module",
  "license": "MIT",
  "author": "shin2344234 (https://github.com/shin2344234)",
  "homepage": "https://github.com/shin2344234/godot-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shin2344234/godot-mcp.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/shin2344234/godot-mcp/issues"
  },
  "bin": {
    "godot-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "addon",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "prepack": "node ../scripts/check-versions.mjs && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build && node scripts/copy-addon.mjs",
    "gen:gdscript-docs": "node scripts/gen-gdscript-docs.mjs",
    "check:versions": "node ../scripts/check-versions.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "godot",
    "godot4",
    "godot-engine",
    "gdscript",
    "gamedev",
    "game-development",
    "ai",
    "llm",
    "agent",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "add-mcp": "^2.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
